#!/usr/bin/env bash
# changelog-fragments: the changelog.d/ convention, in one script.
#
# Every pull request used to edit CHANGELOG.md under "## Unreleased", so two
# open pull requests always conflicted and merged one at a time. Now each pull
# request adds its own file under changelog.d/ and the maintainer compiles the
# files into CHANGELOG.md when tagging. Two pull requests never touch the same
# file.
#
# Usage:
#   changelog-fragments new SLUG TEXT...   write changelog.d/<date>-<slug>.md
#   changelog-fragments lint               validate every fragment in the tree
#   changelog-fragments pr [BASE]          the pull-request rules, against BASE
#                                          (default origin/main, else main)
#   changelog-fragments status ITEM SLUG TEXT...
#                                          write changelog.d/roadmap/<date>-<slug>.md,
#                                          a status line for docs/ROADMAP.md item
#                                          ITEM (A3.30 is Amendment 3, item 30)
#   changelog-fragments compile [--dry-run]
#                                          move fragments into CHANGELOG.md and
#                                          roadmap status fragments into docs/ROADMAP.md
#
# Runs against the repository holding the current directory. Pure bash, git
# and awk. Exit 1 on any finding.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not in a git repository" >&2; exit 2; }
cd "$ROOT" || exit 2
DIR=changelog.d
LOG=CHANGELOG.md
RDIR=changelog.d/roadmap
ROAD=docs/ROADMAP.md
# A pull request that touches only these prefixes needs no fragment: the kit
# exports are listed once by their commit titles, never itemized.
EXEMPT_RE='^(phase-zero|public-kit|\.claude)/'

die() { echo "changelog-fragments: $*" >&2; exit 1; }

# Fragment files on disk, one per line, README excluded.
list_fragments() {
  [ -d "$DIR" ] || return 0
  find "$DIR" -maxdepth 1 -type f -name '*.md' ! -name README.md | sort
}

# Roadmap status fragments, one per line, in date order (oldest first, so two
# fragments for one item land in the order they were written).
list_roadmap() {
  [ -d "$RDIR" ] || return 0
  find "$RDIR" -maxdepth 1 -type f -name '*.md' | sort
}

# lint_roadmap FILE: line 1 is "item: A<amendment>.<item>", then one
# paragraph of ready-to-insert Markdown (it carries its own bold lead, such
# as "**Status: executed 2026-10-16, [#1](...).** ...").
lint_roadmap() {
  f="$1"
  case "$(basename "$f")" in
    *[!a-z0-9._-]*|[!a-z0-9]*) echo "$f: file name may use only a-z, 0-9, dot, dash and underscore, and starts with a letter or digit"; return 1 ;;
  esac
  body="$(sed -e 's/[[:space:]]*$//' "$f")"
  [ -n "$(printf '%s' "$body" | tr -d '[:space:]')" ] || { echo "$f: empty"; return 1; }
  printf '%s\n' "$body" | grep -qE '^[[:space:]]*$' && { echo "$f: no blank lines; one paragraph"; return 1; }
  first="$(printf '%s\n' "$body" | sed -n '1p')"
  printf '%s\n' "$first" | grep -qE '^item: A[0-9]+\.[0-9]+$' || { echo "$f: line 1 must be 'item: A<amendment>.<item>', such as 'item: A3.30'"; return 1; }
  [ "$(printf '%s\n' "$body" | wc -l | tr -d ' ')" -ge 2 ] || { echo "$f: no status text after the item line"; return 1; }
  case "$(printf '%s\n' "$body" | sed -n '2p')" in
    '#'*|'- '*|'* '*) echo "$f: the text is a plain paragraph, no heading or bullet"; return 1 ;;
  esac
  return 0
}

default_base() {
  if git rev-parse --verify -q origin/main >/dev/null; then echo origin/main; else echo main; fi
}

# lint_one FILE: print a reason and return 1 when the fragment is malformed.
lint_one() {
  f="$1"
  case "$(basename "$f")" in
    [a-z0-9]*.md) ;;
    *) echo "$f: file name must start with a lowercase letter or digit"; return 1 ;;
  esac
  case "$(basename "$f")" in
    *[!a-z0-9._-]*) echo "$f: file name may use only a-z, 0-9, dot, dash and underscore"; return 1 ;;
  esac
  body="$(sed -e 's/[[:space:]]*$//' "$f")"
  [ -n "$(printf '%s' "$body" | tr -d '[:space:]')" ] || { echo "$f: empty"; return 1; }
  # $(...) already dropped trailing blank lines, so any blank line left is
  # leading or inside the entry.
  if printf '%s\n' "$body" | grep -qE '^[[:space:]]*$'; then
    echo "$f: one entry per fragment, no blank lines"; return 1
  fi
  first="$(printf '%s\n' "$body" | sed -n '1p')"
  case "$first" in
    '#'*)    echo "$f: no headings; the entry is plain text"; return 1 ;;
    '- '*|'* '*) echo "$f: no leading bullet marker; compile adds it"; return 1 ;;
  esac
  case "$first" in
    skip:*) [ "$(printf '%s\n' "$body" | wc -l | tr -d ' ')" -eq 1 ] || { echo "$f: a skip fragment is one line: 'skip: reason'"; return 1; }
            [ -n "$(printf '%s' "${first#skip:}" | tr -d '[:space:]')" ] || { echo "$f: skip needs a reason"; return 1; } ;;
  esac
  return 0
}

cmd_lint() {
  fail=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    msg="$(lint_one "$f")" || { echo "$msg"; fail=1; }
  done < <(list_fragments)
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    msg="$(lint_roadmap "$f")" || { echo "$msg"; fail=1; }
  done < <(list_roadmap)
  [ "$fail" -eq 0 ] && echo "changelog fragments: $(list_fragments | wc -l | tr -d ' ') valid, $(list_roadmap | wc -l | tr -d ' ') roadmap"
  return "$fail"
}

cmd_status() {
  [ $# -ge 3 ] || die "usage: status ITEM SLUG TEXT... (ITEM like A3.30)"
  item="$1"; slug="$2"; shift 2
  mkdir -p "$RDIR"
  f="$RDIR/$(date -u +%Y-%m-%d)-$slug.md"
  [ ! -e "$f" ] || die "$f exists"
  printf 'item: %s\n%s\n' "$item" "$*" > "$f"
  msg="$(lint_roadmap "$f")" || { rm -f "$f"; die "$msg"; }
  echo "$f"
}

# roadmap_insert FILE ITEM TEXT: print FILE with TEXT added after the last
# line of ITEM (A3.30) in its amendment section, indented under the item the
# way the existing status lines are. Exit 1 when the item is not found.
roadmap_insert() {
  RM_TXT="$3" awk -v key="$2" '
    BEGIN { txt = ENVIRON["RM_TXT"]; split(key, k, /[A.]/); amend = k[2]; num = k[3] }
    { line[NR] = $0 }
    END {
      sec = 0; start = 0; stop = NR
      for (i = 1; i <= NR; i++) {
        if (line[i] ~ /^## /) { if (start) { stop = i - 1; break } sec = (line[i] ~ ("^## Amendment " amend "( |$)")) }
        else if (sec && !start && line[i] ~ ("^" num "\\. \\*\\*")) start = i
        else if (start && line[i] ~ /^[0-9]+\. /) { stop = i - 1; break }
        else if (start && line[i] ~ /^#/) { stop = i - 1; break }
      }
      if (!start) exit 1
      while (stop > start && line[stop] ~ /^[[:space:]]*$/) stop--
      for (i = 1; i <= stop; i++) print line[i]
      print ""; print "   " txt
      for (i = stop + 1; i <= NR; i++) print line[i]
    }' "$1"
}

cmd_new() {
  [ $# -ge 2 ] || die "usage: new SLUG TEXT..."
  slug="$1"; shift
  mkdir -p "$DIR"
  f="$DIR/$(date -u +%Y-%m-%d)-$slug.md"
  [ ! -e "$f" ] || die "$f exists"
  printf '%s\n' "$*" > "$f"
  msg="$(lint_one "$f")" || { rm -f "$f"; die "$msg"; }
  echo "$f"
}

# New-file line ranges inside "## Unreleased" of CHANGELOG.md at HEAD: prints
# "start end", or nothing when the heading is absent.
unreleased_range() {
  git show "HEAD:$LOG" 2>/dev/null | awk '
    /^## / { if (inside) { print start, NR - 1; inside = 0; done = 1 } if ($0 == "## Unreleased") { inside = 1; start = NR } }
    END { if (inside && !done) print start, NR }'
}

cmd_pr() {
  base="${1:-$(default_base)}"
  git rev-parse --verify -q "$base" >/dev/null || die "base ref '$base' not found (fetch it, or pass one)"
  changed="$(git diff --name-only "$base...HEAD")"
  [ -n "$changed" ] || { echo "no changes against $base"; return 0; }
  if ! printf '%s\n' "$changed" | grep -qvE "$EXEMPT_RE"; then
    echo "changelog: only kit-export paths changed; no fragment needed"; return 0
  fi
  added="$(git diff --name-only --diff-filter=A "$base...HEAD" -- "$DIR" | grep -v '^changelog\.d/README\.md$' | grep -v "^$RDIR/" | grep '\.md$' || true)"
  deleted="$(git diff --name-only --diff-filter=D "$base...HEAD" -- "$DIR" | grep -v '^changelog\.d/README\.md$' | grep -v "^$RDIR/" || true)"
  radded="$(git diff --name-only --diff-filter=A "$base...HEAD" -- "$RDIR" | grep '\.md$' || true)"
  rdeleted="$(git diff --name-only --diff-filter=D "$base...HEAD" -- "$RDIR" || true)"
  fail=0
  if printf '%s\n' "$changed" | grep -qx "$LOG"; then
    if [ -z "$deleted" ]; then
      range="$(unreleased_range)"
      if [ -n "$range" ]; then
        # Added lines of this diff that land inside the Unreleased section.
        hit="$(git diff -U0 "$base...HEAD" -- "$LOG" | awk -v lo="${range% *}" -v hi="${range#* }" '
          /^@@/ { split($3, a, ","); n = substr(a[1], 2) + 0; next }
          /^\+\+\+/ { next }
          /^\+/ { if (n >= lo && n <= hi) c++; n++ }
          END { print c + 0 }')"
        if [ "$hit" -gt 0 ]; then
          echo "FAIL: $LOG gained $hit line(s) under '## Unreleased'. Add a fragment instead: scripts/changelog-fragments new SLUG TEXT"
          fail=1
        fi
      fi
    fi
  fi
  # Status lines go in as fragments; only the assembler (it deletes some) adds them to the file.
  if printf '%s\n' "$changed" | grep -qx "$ROAD" && [ -z "$rdeleted" ]; then
    rhit="$(git diff -U0 "$base...HEAD" -- "$ROAD" | grep -cE '^\+ *\*\*(Status|Update|Open)' || true)"
    if [ "${rhit:-0}" -gt 0 ]; then
      echo "FAIL: $ROAD gained $rhit status line(s). Add a fragment instead: scripts/changelog-fragments status ITEM SLUG TEXT"
      fail=1
    fi
  fi
  if [ -z "$added" ] && [ -z "$deleted" ]; then
    echo "FAIL: no changelog fragment added. Run: scripts/changelog-fragments new SLUG TEXT (or a one-line 'skip: reason' fragment)"
    fail=1
  fi
  # Added fragments must be well formed.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    msg="$(lint_one "$f")" || { echo "FAIL: $msg"; fail=1; }
  done <<EOF2
$added
EOF2
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    msg="$(lint_roadmap "$f")" || { echo "FAIL: $msg"; fail=1; }
  done <<EOF2
$radded
EOF2
  [ "$fail" -eq 0 ] && echo "changelog: fragment rules satisfied against $base"
  return "$fail"
}

cmd_compile() {
  dry=0
  [ "${1:-}" = "--dry-run" ] && dry=1
  cmd_lint >/dev/null || { cmd_lint; die "fix the fragments first"; }
  files="$(list_fragments | sort -r)"
  rfiles="$(list_roadmap)"
  [ -n "$files$rfiles" ] || { echo "no fragments to compile"; return 0; }
  out="$(mktemp)"; rnew="$(mktemp)"; trap 'rm -f "$out" "$rnew"' EXIT
  n=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    first="$(sed -n '1p' "$f")"
    case "$first" in skip:*) continue ;; esac
    awk 'NF { if (!s) { print "- " $0; s = 1 } else print "  " $0 }' "$f" >> "$out"
    n=$((n + 1))
  done <<EOF2
$files
EOF2
  # Roadmap statuses, oldest first, each inserted into the running copy.
  rn=0
  if [ -n "$rfiles" ]; then
    [ -f "$ROAD" ] || die "no $ROAD"
    cp "$ROAD" "$rnew"
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      item="$(sed -n '1s/^item: //p' "$f")"
      text="$(sed -n '2,$p' "$f" | tr '\n' ' ' | sed -e 's/[[:space:]]*$//')"
      step="$(mktemp)"
      roadmap_insert "$rnew" "$item" "$text" > "$step" || { rm -f "$step"; die "$f: no item $item in $ROAD"; }
      cat "$step" > "$rnew"; rm -f "$step"
      rn=$((rn + 1))
    done <<EOF2
$rfiles
EOF2
  fi
  if [ "$dry" -eq 1 ]; then
    cat "$out"
    [ "$rn" -gt 0 ] && diff "$ROAD" "$rnew"
    echo "($n entries, $rn roadmap statuses, dry run, nothing written)" >&2; return 0
  fi
  if [ "$n" -gt 0 ] || [ -n "$files" ]; then
    grep -qx '## Unreleased' "$LOG" || die "no '## Unreleased' heading in $LOG"
    new="$(mktemp)"
    awk -v ins="$out" '
      { print }
      $0 == "## Unreleased" && !d { getline nxt; print ""; while ((getline line < ins) > 0) print line; if (nxt != "") print nxt; if ((getline nx2) > 0) { if (nx2 ~ /^#/) print ""; print nx2 } d = 1 }' "$LOG" > "$new"
    cat "$new" > "$LOG"; rm -f "$new"
  fi
  [ "$rn" -gt 0 ] && cat "$rnew" > "$ROAD"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    git ls-files --error-unmatch "$f" >/dev/null 2>&1 && git rm -q -f "$f" || rm -f "$f"
  done <<EOF2
$files
$rfiles
EOF2
  echo "compiled $n entries into $LOG and $rn statuses into $ROAD; removed $(printf '%s\n%s\n' "$files" "$rfiles" | grep -c .) fragment file(s)"
}

case "${1:-}" in
  new) shift; cmd_new "$@" ;;
  status) shift; cmd_status "$@" ;;
  lint) cmd_lint ;;
  pr) shift; cmd_pr "$@" ;;
  compile) shift; cmd_compile "$@" ;;
  *) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
