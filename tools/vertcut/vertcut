#!/usr/bin/env bash
# vertcut — bare-minimum AI-assisted vertical-clip workflow.
#
#   vertcut transcribe SRC [-o DIR] [--model M]   word-level transcript for clip picking, with
#                                                 singing, music and hallucinations withheld
#   vertcut kinds FILE [--apply-overrides SUNG_TSV]  what each segment is: kinds and time ranges only
#   vertcut cut SRC CLIPS.tsv [options]           9:16 captioned exports from a cuts manifest
#   vertcut cut SRC CLIPS.tsv --review --only ID --variant SPEC ... -o DIR   blind A/B packet of one row
#   vertcut manifest SRC CLIPS.tsv --words J -o OUT.json   cuts manifest v2 for the Resolve route
#
# Full docs: tools/vertcut/README.md
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${VERTCUT_PYTHON:-$HOME/.venvs/rp-tools/bin/python}"

die() { printf 'vertcut: %s\n' "$1" >&2; exit 1; }

usage() {
  sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"; }

cmd_transcribe() {
  local src="" out="" model="mlx-community/whisper-large-v3-turbo" overrides="" keep_raw=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -o|--out) out="${2:?-o needs a directory}"; shift 2 ;;
      --model)  model="${2:?--model needs a name}"; shift 2 ;;
      --overrides) overrides="${2:?--overrides needs a sung.tsv}"; shift 2 ;;
      --discard-raw) keep_raw=0; shift ;;
      -h|--help) usage ;;
      *) [ -z "$src" ] && src="$1" && shift || die "unexpected argument: $1" ;;
    esac
  done
  [ -n "$src" ] || usage 1
  [ -f "$src" ] || die "no such file: $src"
  [ -z "$overrides" ] || [ -f "$overrides" ] || die "no such sung.tsv: $overrides"

  local mw
  # The venv's copy first, then one on PATH; VERTCUT_MLX_WHISPER overrides both.
  mw="${VERTCUT_MLX_WHISPER:-$HOME/.venvs/rp-tools/bin/mlx_whisper}"
  [ -n "${VERTCUT_MLX_WHISPER:-}" ] || [ -x "$mw" ] || mw="$(command -v mlx_whisper || echo "$mw")"
  [ -x "$mw" ] || die "mlx_whisper not found at $mw (install it into the venv:
  ~/.venvs/rp-tools/bin/python -m pip install -c $(cd "$HERE/../.." && pwd)/requirements.txt mlx-whisper==0.4.3,
  or set VERTCUT_MLX_WHISPER)"
  need ffmpeg

  local base; base="$(basename "${src%.*}")"
  out="${out:-$(dirname "$src")}"
  mkdir -p "$out"

  # Whisper wants 16k mono; feeding it the raw .mov is slow and sometimes fails.
  # The WAV is scratch: it goes to a temp dir and is deleted, never beside the
  # output, where a synced or autocommitted folder would pick it up.
  # Global, not local: the EXIT trap runs after this function has returned.
  VERTCUT_TMP="$(mktemp -d "${TMPDIR:-/tmp}/vertcut.XXXXXX")"
  trap 'rm -rf "${VERTCUT_TMP:-}"' EXIT
  local wav="$VERTCUT_TMP/$base.16k.wav"
  echo "vertcut: extracting audio (temp)"
  ffmpeg -hide_banner -loglevel error -y -i "$src" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$wav"

  # Conditioning each window on the previous text lets Whisper fall into
  # repetition loops ("learn how to learn how to ..." for minutes on Say Why
  # Ep 002); off, with the silence guard, those regions transcribe cleanly.
  #
  # Whisper also writes singing as words (lyrics) and wind as sentences. The
  # raw result goes to <name>.raw.json, which nothing reads by default; the
  # safe <name>.json is made from it below, while the audio is still here.
  #
  # mlx_whisper's default --verbose True prints every segment's text to stdout,
  # which puts lyrics in a terminal, a log, or an agent's context. It is turned
  # off, and its stdout is discarded; progress and errors stay on stderr. It
  # also names its output after the audio file, ignoring a dotted --output-name,
  # so it writes into the temp dir and the raw file is moved to <name>.raw.json.
  echo "vertcut: transcribing with $model (word timestamps; transcript text is not printed)"
  "$mw" "$wav" --model "$model" --word-timestamps True \
    --condition-on-previous-text False --hallucination-silence-threshold 2 \
    --output-dir "$VERTCUT_TMP" --output-name "$base" --output-format json \
    --verbose False >/dev/null
  [ -f "$VERTCUT_TMP/$base.json" ] || die "mlx_whisper wrote no transcript"
  mv "$VERTCUT_TMP/$base.json" "$out/$base.raw.json"
  chmod 600 "$out/$base.raw.json" 2>/dev/null || true

  echo "vertcut: screening segments (speech, singing, music, hallucination)"
  local args=(redact "$out/$base.raw.json" --audio "$wav" --out "$out/$base.json" --clip "$base")
  [ -z "$overrides" ] || args+=(--overrides "$overrides")
  if ! "$PY" "$HERE/lib/segkind.py" "${args[@]}"; then
    rm -f "$out/$base.json"
    die "screening failed; no safe transcript was written. The raw transcript is $out/$base.raw.json: do not open it. Fix the cause, then run: vertcut kinds \"$out/$base.raw.json\" --write"
  fi
  [ "$keep_raw" = 1 ] || rm -f "$out/$base.raw.json"
  rm -rf "$VERTCUT_TMP"

  echo "vertcut: wrote $out/$base.json (safe: withheld text replaced by a label)"
  echo "         and $out/$base.kinds.json (kinds and time ranges, no text)."
  if [ "$keep_raw" = 1 ]; then
    echo "         $out/$base.raw.json is the unredacted transcript; do not open or paste it."
    echo "         Look at a clip with: vertcut kinds \"$out/$base.json\""
  fi
  echo "         pass the safe .json to \`vertcut cut --words $out/$base.json\` to burn captions."
}

cmd_kinds() {
  exec "$PY" "$HERE/lib/segkind.py" kinds "$@"
}

cmd_cut() {
  need ffmpeg; need ffprobe
  exec "$PY" "$HERE/lib/vertcut_cut.py" "$@"
}

cmd_manifest() {
  exec "$PY" "$HERE/lib/vertcut_manifest.py" "$@"
}

case "${1:-}" in
  transcribe) shift; cmd_transcribe "$@" ;;
  kinds)      shift; cmd_kinds "$@" ;;
  cut)        shift; cmd_cut "$@" ;;
  manifest)   shift; cmd_manifest "$@" ;;
  -h|--help|"") usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
