#!/usr/bin/env bash
# vertcut — bare-minimum AI-assisted vertical-clip workflow.
#
#   vertcut transcribe SRC [-o DIR] [--model M]   word-level transcript for clip picking
#   vertcut cut SRC CLIPS.tsv [options]           9:16 captioned exports from a cuts manifest
#   vertcut manifest SRC CLIPS.tsv --words J -o OUT.json   cuts manifest v2 for the Resolve route
#
# Full docs: tools/vertcut/README.md
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${VERTCUT_PYTHON:-$HOME/.venvs/rp-tools/bin/python}"

die() { printf 'vertcut: %s\n' "$1" >&2; exit 1; }

usage() {
  sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"; }

cmd_transcribe() {
  local src="" out="" model="mlx-community/whisper-large-v3-turbo"
  while [ $# -gt 0 ]; do
    case "$1" in
      -o|--out) out="${2:?-o needs a directory}"; shift 2 ;;
      --model)  model="${2:?--model needs a name}"; shift 2 ;;
      -h|--help) usage ;;
      *) [ -z "$src" ] && src="$1" && shift || die "unexpected argument: $1" ;;
    esac
  done
  [ -n "$src" ] || usage 1
  [ -f "$src" ] || die "no such file: $src"

  local mw
  # The venv's copy first, then one on PATH; VERTCUT_MLX_WHISPER overrides both.
  mw="${VERTCUT_MLX_WHISPER:-$HOME/.venvs/rp-tools/bin/mlx_whisper}"
  [ -n "${VERTCUT_MLX_WHISPER:-}" ] || [ -x "$mw" ] || mw="$(command -v mlx_whisper || echo "$mw")"
  [ -x "$mw" ] || die "mlx_whisper not found at $mw (install it into the venv:
  ~/.venvs/rp-tools/bin/python -m pip install -c $(cd "$HERE/../.." && pwd)/requirements.txt mlx-whisper==0.4.3,
  or set VERTCUT_MLX_WHISPER)"
  need ffmpeg

  local base; base="$(basename "${src%.*}")"
  out="${out:-$(dirname "$src")}"
  mkdir -p "$out"

  # Whisper wants 16k mono; feeding it the raw .mov is slow and sometimes fails.
  # The WAV is scratch: it goes to a temp dir and is deleted, never beside the
  # output, where a synced or autocommitted folder would pick it up.
  # Global, not local: the EXIT trap runs after this function has returned.
  VERTCUT_TMP="$(mktemp -d "${TMPDIR:-/tmp}/vertcut.XXXXXX")"
  trap 'rm -rf "${VERTCUT_TMP:-}"' EXIT
  local wav="$VERTCUT_TMP/$base.16k.wav"
  echo "vertcut: extracting audio (temp)"
  ffmpeg -hide_banner -loglevel error -y -i "$src" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$wav"

  # Conditioning each window on the previous text lets Whisper fall into
  # repetition loops ("learn how to learn how to ..." for minutes on Say Why
  # Ep 002); off, with the silence guard, those regions transcribe cleanly.
  echo "vertcut: transcribing with $model (word timestamps)"
  "$mw" "$wav" --model "$model" --word-timestamps True \
    --condition-on-previous-text False --hallucination-silence-threshold 2 \
    --output-dir "$out" --output-name "$base" --output-format json
  rm -rf "$VERTCUT_TMP"

  echo "vertcut: wrote $out/$base.json"
  echo "         pass it to \`vertcut cut --words $out/$base.json\` to burn captions."
}

cmd_cut() {
  need ffmpeg; need ffprobe
  exec "$PY" "$HERE/lib/vertcut_cut.py" "$@"
}

cmd_manifest() {
  exec "$PY" "$HERE/lib/vertcut_manifest.py" "$@"
}

case "${1:-}" in
  transcribe) shift; cmd_transcribe "$@" ;;
  cut)        shift; cmd_cut "$@" ;;
  manifest)   shift; cmd_manifest "$@" ;;
  -h|--help|"") usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
