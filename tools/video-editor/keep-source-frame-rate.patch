# keep-source-frame-rate.patch
#
# Upstream:  https://github.com/browser-use/video-use (Browser Use), MIT licence.
# Pin:       92c2b34e44c205cbc2acae7f6ca7c1c219d5dd66
# Applies to: helpers/render.py, from the root of the fetched video-use/ folder.
#
# What it does: probes the first range's source with ffprobe and extracts every
# segment at that exact rational rate (for example 24000/1001) instead of a
# forced `-r 24`. The concat is lossless, so one rate serves the whole render;
# a source at another rate is converted to the first range's. An unreadable
# probe falls back to 24. Concat, overlay and loudnorm assume no rate.
#
# The hunks below are changes to upstream code, republished under its MIT
# licence: Copyright (c) 2026 Browser Use. fetch-video-use.sh applies this file.
# Everything above the first `diff --git` line is ignored by `git apply`.
#
diff --git a/helpers/render.py b/helpers/render.py
index 0d02cff..a345fc7 100644
--- a/helpers/render.py
+++ b/helpers/render.py
@@ -146,6 +146,24 @@ def is_portrait_source(video: Path) -> bool:
         return False
 
 
+def source_fps(video: Path) -> str:
+    """Return the video's frame rate as an exact rational such as 24000/1001."""
+    for field in ("avg_frame_rate", "r_frame_rate"):
+        try:
+            out = subprocess.run(
+                ["ffprobe", "-v", "error", "-select_streams", "v:0",
+                 "-show_entries", f"stream={field}",
+                 "-of", "csv=p=0", str(video)],
+                capture_output=True, text=True, check=True,
+            )
+            num, den = map(int, out.stdout.strip().split("/"))
+            if num > 0 and den > 0:
+                return f"{num}/{den}"
+        except Exception:
+            continue
+    return "24"
+
+
 # -------- Per-segment extraction (Rule 2 + Rule 3) --------------------------
 
 
@@ -157,6 +175,7 @@ def extract_segment(
     out_path: Path,
     preview: bool = False,
     draft: bool = False,
+    fps: str = "24",
 ) -> None:
     """Extract a cut range as its own MP4 with grade + 30ms audio fades baked in.
 
@@ -203,7 +222,7 @@ def extract_segment(
         "-vf", vf,
         "-af", af,
         "-c:v", "libx264", "-preset", preset, "-crf", crf,
-        "-pix_fmt", "yuv420p", "-r", "24",
+        "-pix_fmt", "yuv420p", "-r", fps,
         "-c:a", "aac", "-b:a", "192k", "-ar", "48000",
         "-movflags", "+faststart",
         str(out_path),
@@ -234,8 +253,13 @@ def extract_all_segments(
     ranges = edl["ranges"]
     sources = edl["sources"]
 
+    # One rate for the whole render, since the concat is lossless: the first
+    # range's source sets it, and any source at another rate is converted to it.
+    fps = source_fps(resolve_path(sources[ranges[0]["source"]], edit_dir))
+
     seg_paths: list[Path] = []
     print(f"extracting {len(ranges)} segment(s) → {clips_dir.name}/")
+    print(f"  frame rate: {fps}")
     if is_auto:
         print("  (auto-grade per segment: analyzing each range)")
     for i, r in enumerate(ranges):
@@ -255,7 +279,7 @@ def extract_all_segments(
         print(f"  [{i:02d}] {src_name}  {start:7.2f}-{end:7.2f}  ({duration:5.2f}s)  {note}")
         if is_auto:
             print(f"        grade: {seg_filter or '(none)'}")
-        extract_segment(src_path, start, duration, seg_filter, out_path, preview=preview, draft=draft)
+        extract_segment(src_path, start, duration, seg_filter, out_path, preview=preview, draft=draft, fps=fps)
         seg_paths.append(out_path)
 
     return seg_paths
