#!/bin/bash
# rp-grant — Manage the Say Why grant pipeline
# Usage: rp-grant <command> [args]
#   rp-grant add                    — Add a new funder (interactive)
#   rp-grant list [status]          — List funders by status
#   rp-grant deadlines              — Show upcoming deadlines
#   rp-grant update <slug> <status> — Update funder status
#   rp-grant log <slug> "note"      — Log an action

# Resolve this script's real directory (through any symlink) and load shared helpers.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"; [ "${src#/}" = "$src" ] && src="$dir/$src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$src")" && pwd)"
. "$SCRIPT_DIR/_rp-common.sh"

GRANTS="$OUTREACH/grants/funders"
TEMPLATE="$OUTREACH/grants/funder-template.md"
# Fall back to the template bundled with this repo if the vault copy doesn't exist
[ -f "$TEMPLATE" ] || TEMPLATE="$SCRIPT_DIR/../templates/funder-template.md"
TODAY=$(date +%Y-%m-%d)

CMD="${1:-help}"

case "$CMD" in

add)
  echo "=== Add Funder to Grant Pipeline ==="
  echo ""
  read -p "Funder name: " FUNDER_NAME
  read -p "Type (foundation/government/corporate): " TYPE
  read -p "Website: " WEBSITE
  read -p "Focus areas (comma-separated): " FOCUS
  read -p "Grant range (e.g., \$5K-50K): " RANGE
  read -p "Next deadline (YYYY-MM-DD or unknown): " DEADLINE
  read -p "Angle (narrative-SDOH/anti-extractive-media/info-metabolism/digital-equity): " ANGLE

  SLUG=$(slugify "$FUNDER_NAME")
  mkdir -p "$GRANTS"
  FILEPATH="$GRANTS/$SLUG.md"
  
  if [ -f "$FILEPATH" ]; then
    echo "⚠ Funder already exists: $SLUG"
    exit 1
  fi
  
  sed \
    -e "s|{{FUNDER_NAME}}|$FUNDER_NAME|g" \
    -e "s|{{WEBSITE}}|$WEBSITE|g" \
    "$TEMPLATE" > "$FILEPATH"
  
  sedi "s#type: \"foundation|government|corporate|individual\"#type: \"$TYPE\"#" "$FILEPATH"
  sedi "s|grant_range: \"\"|grant_range: \"$RANGE\"|" "$FILEPATH"
  sedi "s|deadline: \"\"|deadline: \"$DEADLINE\"|" "$FILEPATH"
  sedi "s|angle: \"\"|angle: \"$ANGLE\"|" "$FILEPATH"
  
  echo "✓ Funder added: $SLUG.md"
  echo "  Open in Obsidian to complete fit assessment"
  ;;

list)
  FILTER="${2:-all}"
  echo "=== Grant Pipeline ==="
  echo "    $TODAY"
  echo ""
  for status in research loi-prep submitted reviewed awarded declined; do
    if [ "$FILTER" != "all" ] && [ "$FILTER" != "$status" ]; then
      continue
    fi
    header_printed=false
    for f in "$GRANTS"/*.md; do
      [ -f "$f" ] || continue
      file_status=$(fm "$f" status)
      if [ "$file_status" = "$status" ]; then
        if [ "$header_printed" = false ]; then
          echo "--- $status ---"
          header_printed=true
        fi
        funder=$(fm "$f" funder)
        range=$(fm "$f" grant_range)
        deadline=$(fm "$f" deadline)
        angle=$(fm "$f" angle)
        printf "  %-30s %-15s deadline:%-12s %s\n" "$funder" "$range" "${deadline:---}" "$angle"
      fi
    done
    if [ "$header_printed" = true ]; then echo ""; fi
  done
  ;;

deadlines)
  echo "=== Upcoming Grant Deadlines ==="
  echo ""
  out=$(for f in "$GRANTS"/*.md; do
    [ -f "$f" ] || continue
    deadline=$(fm "$f" deadline)
    [ -z "$deadline" ] && continue
    funder=$(fm "$f" funder)
    status=$(fm "$f" status)
    next=$(fm "$f" next_action)
    printf "  %-12s %-30s %-12s %s\n" "$deadline" "$funder" "$status" "$next"
  done | sort)
  if [ -n "$out" ]; then
    echo "$out"
  else
    echo "  No deadlines set. Add them with rp-grant update <slug>"
  fi
  ;;

update)
  SLUG="$2"
  NEW_STATUS="$3"
  FILEPATH="$GRANTS/$SLUG.md"
  if [ ! -f "$FILEPATH" ]; then
    echo "✗ No funder found: $SLUG"
    exit 1
  fi
  sedi "s|^status: .*|status: $NEW_STATUS|" "$FILEPATH"
  sedi "s|^last_action: .*|last_action: \"$TODAY\"|" "$FILEPATH"
  funder=$(fm "$FILEPATH" funder)
  echo "✓ $funder → $NEW_STATUS"
  ;;

log)
  SLUG="$2"
  NOTE="$3"
  FILEPATH="$GRANTS/$SLUG.md"
  if [ ! -f "$FILEPATH" ]; then
    echo "✗ No funder found: $SLUG"
    exit 1
  fi
  sedi "s|^last_action: .*|last_action: \"$TODAY\"|" "$FILEPATH"
  sedi "/## Action Log/a\\
\\
- **$TODAY** | $NOTE" "$FILEPATH"
  funder=$(fm "$FILEPATH" funder)
  echo "✓ Logged action for $funder"
  ;;

help|-h|--help|*)
  echo "rp-grant — Say Why Grant Pipeline Manager"
  echo ""
  echo "Commands:"
  echo "  add                     Add a new funder (interactive)"
  echo "  list [status]           List funders (all|research|loi-prep|submitted|reviewed|awarded)"
  echo "  deadlines               Show upcoming deadlines sorted by date"
  echo "  update <slug> <status>  Update funder status"
  echo "  log <slug> \"note\"       Log an action to a funder"
  echo ""
  echo "Grant statuses: research → loi-prep → submitted → reviewed → awarded/declined"
  ;;

esac