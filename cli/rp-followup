#!/bin/bash
# rp-followup — Show contacts due for follow-up
# Usage: rp-followup

# Resolve this script's real directory (through the install.sh symlink) and load shared helpers.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"; [ "${src#/}" = "$src" ] && src="$dir/$src"
done
. "$(cd -P "$(dirname "$src")" && pwd)/_rp-common.sh"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "rp-followup — Show contacts due for follow-up"
  echo ""
  echo "Usage: rp-followup"
  echo "Lists prospects whose next_followup date has arrived, then contacted"
  echo "prospects with no follow-up scheduled."
  exit 0
fi

PROSPECTS="$OUTREACH/prospects"
TODAY=$(date +%Y-%m-%d)

echo "=== Follow-ups Due ==="
echo "    $TODAY"
echo ""

found=false
for f in "$PROSPECTS"/*.md; do
  [ -f "$f" ] || continue
  next=$(fm "$f" next_followup)
  [ -z "$next" ] && continue

  if [[ "$next" < "$TODAY" ]] || [[ "$next" == "$TODAY" ]]; then
    org=$(fm "$f" org)
    contact=$(fm "$f" contact)
    touches=$(fm "$f" touch_count)
    last=$(fm "$f" last_contact)
    slug=$(basename "$f" .md)

    echo "  $org ($contact)"
    echo "    Due: $next | Last: $last | Touches: $touches"
    echo "    → rp-draft $slug"
    echo ""
    found=true
  fi
done

if [ "$found" = false ]; then
  echo "  No follow-ups due. Nice."
fi

# Also show contacted with no follow-up set
echo "--- Contacted (no follow-up scheduled) ---"
echo ""
stale=false
for f in "$PROSPECTS"/*.md; do
  [ -f "$f" ] || continue
  status=$(fm "$f" status)
  next=$(fm "$f" next_followup)

  if [ "$status" = "contacted" ] && [ -z "$next" ]; then
    org=$(fm "$f" org)
    last=$(fm "$f" last_contact)
    echo "  $org — last contact: $last (no follow-up set)"
    stale=true
  fi
done

if [ "$stale" = false ]; then
  echo "  All contacted prospects have follow-ups scheduled."
fi